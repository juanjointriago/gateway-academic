{
  "name": "gateway-academic",
  "main": "expo-router/entry",
  "version": "1.0.6",
  "scripts": {
    "start": "expo start",
    "dev": "npx expo start --localhost --reset-cache",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage --silent",
    "lint": "expo lint",
    "lint:check": "expo lint --max-warnings 0",
    "android:internal": "eas build --platform android --profile preview",
    "android:bundle": "eas build --platform android",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android:production": "eas build --platform android --profile production --non-interactive",
    "build:ios:preview": "eas build --platform ios --profile preview --non-interactive",
    "build:ios:production": "eas build --platform ios --profile production --non-interactive",
    "submit:android": "eas submit --platform android --latest",
    "submit:ios": "eas submit --platform ios --latest",
    "setup-env-files": "node ./scripts/setup-env-files.js",
    "prebuild": "npm run setup-env-files",
    "doctor": "npx expo-doctor",
    "changelog": "node ./scripts/generate-changelog.js",
    "release:patch": "npm version patch && git push origin main --tags",
    "release:minor": "npm version minor && git push origin main --tags",
    "release:major": "npm version major && git push origin main --tags"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/auth": "^23.8.8",
    "@react-native-firebase/firestore": "^23.8.8",
    "@react-native-firebase/storage": "^23.8.8",
    "@react-native-google-signin/google-signin": "^13.3.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "axios": "^1.14.1",
    "date-fns": "^4.1.0",
    "expo": "~55.0.9",
    "expo-blur": "~55.0.10",
    "expo-build-properties": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.19",
    "expo-file-system": "~55.0.12",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image-picker": "~55.0.14",
    "expo-linking": "~55.0.9",
    "expo-router": "~55.0.8",
    "expo-splash-screen": "~55.0.13",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.11",
    "expo-web-browser": "~55.0.10",
    "lottie-react-native": "^7.3.6",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.72.0",
    "react-native": "0.83.4",
    "react-native-blob-util": "^0.24.7",
    "react-native-css-interop": "^0.1.22",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-paper": "^5.15.0",
    "react-native-paper-dates": "^0.22.57",
    "react-native-pdf": "^6.7.7",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.7.4",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^18.3.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.11",
    "jscodeshift": "^0.15.2",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
